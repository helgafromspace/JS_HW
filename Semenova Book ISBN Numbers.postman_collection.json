		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"let test_name = pm.info.requestName;",
					"",
					"pm.test(`Status code is 200 in test \"${test_name}\"`, function () {",
					"    pm.response.to.have.status(200);",
					"});",
					"",
					"pm.test(\"Content-Type is present\", function () {",
					"    pm.response.to.have.header(\"Content-Type\");",
					"});",
					"",
					"pm.test(`Content-type is text/xml in test \"${test_name}\"`, function () {",
					"    let headerContentType = pm.response.headers.get('Content-type');",
					"    pm.expect(headerContentType).include('text/xml')",
					"});",
					"",
					"pm.test(`Charset is utf-8 in test \"${test_name}\"`, function () {",
					"    let headerContentType = pm.response.headers.get('Content-type');",
					"    pm.expect(headerContentType).include('charset=utf-8')",
					"});",
					""
				]
			}
		}
	],
